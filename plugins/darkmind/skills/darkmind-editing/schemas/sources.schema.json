                    "type": "string",
                    "maxLength": 2000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rights": {
                "type": "object",
                "properties": {
                  "holder": {
                    "type": "string",
                    "maxLength": 200,
                    "description": "Rights holder (person, company, library)"
                  },
                  "license": {
                    "type": "string",
                    "maxLength": 200,
                    "description": "Licence or agreement, e.g. \"CC0\", \"Artlist standard\", \"written permission 2026-11-02\""
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "cleared",
                      "pending",
                      "unknown"
                    ],
                    "description": "cleared = usable in the final render and export; pending/unknown block them"
                  },
                  "scope": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 400
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Where the material may be used (platforms, territories, duration)"
                  },
                  "source": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 400
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Where the material comes from (URL, delivery, archive)"
                  }
                },
                "required": [
                  "holder",
                  "license",
                  "status"
                ],
                "additionalProperties": false,
                "description": "Rights of third-party material (Phase 6 T14): required for asset origins \"stock\" and \"other\"; final render and export block unless \"cleared\""
              },
              "kind": {
                "type": "string",
                "const": "darkmind-video"
              },
              "videoId": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "fileName": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 400
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "original": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "size": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Identity of the downloaded original (size, SHA-256); a changed original needs a new source revision"
              }
            },
            "required": [
              "id",
              "kind",
              "videoId"
            ],
            "additionalProperties": false
