                                    "type": "string",
                                    "maxLength": 40
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "codec": {
                                "type": "string",
                                "maxLength": 40
                              },
                              "pixelFormat": {
                                "type": "string",
                                "maxLength": 40
                              },
                              "alpha": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "width",
                              "height",
                              "rotation",
                              "frameRate",
                              "vfr",
                              "sampleAspectRatio",
                              "colorTransfer",
                              "colorPrimaries"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "audio": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "sampleRate": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 768000
                              },
                              "channels": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 64
                              },
                              "codec": {
                                "type": "string",
                                "maxLength": 40
                              }
                            },
                            "required": [
                              "sampleRate",
                              "channels"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "probedFrom": {
                        "type": "string",
                        "enum": [
                          "original",
                          "asset"
                        ]
                      },
                      "probedAt": {
                        "type": "string",
                        "maxLength": 40
                      }
                    },
                    "required": [
                      "durationSeconds",
                      "video",
                      "audio"
                    ],
                    "additionalProperties": false,
                    "description": "ffprobe facts of the original (or the asset file); decide conform need (C1) and colour gate (C2)"
                  },
