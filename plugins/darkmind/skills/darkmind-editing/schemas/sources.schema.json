{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://darkmind.cloud/schemas/editing-pipeline/v1/sources.schema.json",
  "title": "Dark Mind editing pipeline: sources.json",
  "description": "Format contract v1 of the Dark Mind editing pipeline (doc/AI_EDITING_PIPELINE.md). Structure only; run \"darkmind-agent validate\" for references, frame arithmetic, overlaps, gaps and path rules.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 500,
      "description": "Optional JSON Schema reference for editors; ignored by the validator."
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "label": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "media": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "durationSeconds": {
                        "type": "string",
                        "pattern": "^(?:(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,12})?|(?:0|[1-9][0-9]{0,17})\\/[1-9][0-9]{0,17})$"
                      },
                      "video": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "width": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 100000,
                                "description": "Display width of the correctly oriented image (rotation applied)"
                              },
                              "height": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 100000,
                                "description": "Display height of the correctly oriented image (rotation applied)"
                              },
                              "rotation": {
                                "type": "integer"
                              },
                              "frameRate": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "pattern": "^(?:(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,12})?|(?:0|[1-9][0-9]{0,17})\\/[1-9][0-9]{0,17})$"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ],
                                "description": "Nominal frame rate (r_frame_rate); not used for VFR sources"
                              },
                              "vfr": {
                                "type": "boolean"
                              },
                              "sampleAspectRatio": {
                                "type": "string",
                                "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
                              },
                              "colorTransfer": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "maxLength": 40
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "colorPrimaries": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "maxLength": 40
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "colorSpace": {
                                "anyOf": [
