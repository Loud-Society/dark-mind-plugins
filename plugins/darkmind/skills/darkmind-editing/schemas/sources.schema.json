                                "type": "string",
                                "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
                              },
                              "colorTransfer": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "maxLength": 40
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "colorPrimaries": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "maxLength": 40
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "colorSpace": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "maxLength": 40
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "codec": {
                                "type": "string",
                                "maxLength": 40
                              },
                              "pixelFormat": {
                                "type": "string",
                                "maxLength": 40
                              },
                              "alpha": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "width",
