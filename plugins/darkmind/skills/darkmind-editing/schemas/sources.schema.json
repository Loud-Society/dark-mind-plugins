                              "colorTransfer",
                              "colorPrimaries"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "audio": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "sampleRate": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 768000
                              },
                              "channels": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 64
                              },
                              "codec": {
                                "type": "string",
                                "maxLength": 40
                              }
                            },
                            "required": [
                              "sampleRate",
                              "channels"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "probedFrom": {
                        "type": "string",
                        "enum": [
                          "original",
                          "asset"
                        ]
                      },
                      "probedAt": {
                        "type": "string",
                        "maxLength": 40
                      }
                    },
                    "required": [
                      "durationSeconds",
                      "video",
                      "audio"
                    ],
                    "additionalProperties": false,
                    "description": "ffprobe facts of the original (or the asset file); decide conform need (C1) and colour gate (C2)"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "ffprobe facts of the original (or the asset file); decide conform need (C1) and colour gate (C2)"
              },
              "notes": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 2000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rights": {
                "type": "object",
                "properties": {
                  "holder": {
                    "type": "string",
                    "maxLength": 200,
                    "description": "Rights holder (person, company, library)"
                  },
                  "license": {
                    "type": "string",
                    "maxLength": 200,
                    "description": "Licence or agreement, e.g. \"CC0\", \"Artlist standard\", \"written permission 2026-11-02\""
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "cleared",
                      "pending",
                      "unknown"
                    ],
                    "description": "cleared = usable in the final render and export; pending/unknown block them"
                  },
                  "scope": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 400
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Where the material may be used (platforms, territories, duration)"
                  },
                  "source": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 400
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Where the material comes from (URL, delivery, archive)"
                  }
                },
                "required": [
