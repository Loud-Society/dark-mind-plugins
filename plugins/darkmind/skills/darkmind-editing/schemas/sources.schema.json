                "type": "string",
                "const": "asset"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400,
                "pattern": "^(?!\\/)(?!.*\\/\\/)(?!.*\\/$)(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))[^\\\\<>:\"|?*\\u0000-\\u001f\\u007f]+$",
                "description": "File under assets/ (synced with the project; AI media as generated-media)"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
