{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://darkmind.cloud/schemas/editing-pipeline/v1/extension.schema.json",
  "title": "Dark Mind editing pipeline: extensions/<id>/extension.json",
  "description": "Format contract v1 of the Dark Mind editing pipeline (doc/AI_EDITING_PIPELINE.md). Structure only; run \"darkmind-agent validate\" for references, frame arithmetic, overlaps, gaps and path rules.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 500,
      "description": "Optional JSON Schema reference for editors; ignored by the validator."
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "sceneId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "source"
              },
              "sourceId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              }
            },
            "required": [
              "kind",
              "sourceId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "file"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400,
                "pattern": "^(?!\\/)(?!.*\\/\\/)(?!.*\\/$)(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))[^\\\\<>:\"|?*\\u0000-\\u001f\\u007f]+$"
              }
            },
            "required": [
              "kind",
              "path"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "extension"
              },
              "extensionId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              }
            },
            "required": [
              "kind",
              "extensionId"
            ],
            "additionalProperties": false
          }
        ]
      },
      "maxItems": 500,
      "description": "Every input the command reads, including its scripts; undeclared inputs make the result non-reproducible"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {}
    },
    "command": {
      "type": "object",
      "properties": {
        "program": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4000
          },
          "maxItems": 500
        }
      },
      "required": [
        "program",
        "args"
      ],
      "additionalProperties": false,
      "description": "Local command as program plus argument list (no shell); runs only after explicit local approval"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "version": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "maxItems": 50,
      "default": []
    },
    "output": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "pattern": "^(?!\\/)(?!.*\\/\\/)(?!.*\\/$)(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))[^\\\\<>:\"|?*\\u0000-\\u001f\\u007f]+$",
          "description": "Rendered file under renders/extensions/ (written by the command, checked with ffprobe)"
        },
        "durationFrames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "width": {
          "type": "integer",
          "minimum": 2,
          "maximum": 7680
        },
        "height": {
          "type": "integer",
          "minimum": 2,
          "maximum": 7680
        },
        "fps": {
          "type": "string",
          "pattern": "^(?:(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,12})?|(?:0|[1-9][0-9]{0,17})\\/[1-9][0-9]{0,17})$"
        },
        "audio": {
          "type": "boolean"
        },
        "alpha": {
          "type": "boolean"
        },
        "video": {
          "type": "boolean",
          "description": "false = audio-only output (e.g. WAV; Phase 6 audio blocks): no video stream, audio required, alpha false; durationFrames still counts frames at fps (the project rate). Default true"
        },
        "image": {
          "type": "boolean",
          "description": "true = still image (PNG; Phase 6 thumbnail): a deliverable next to the video, not a clip – exactly one frame (durationFrames 1), no audio, width/height of the image (independent of the project size), never placed on the timeline and not part of the preview review (own review \"thumbnail\"; parameters.candidates marks a contact sheet of proposals, which cannot be approved). Default false"
        }
      },
      "required": [
        "path",
        "durationFrames",
        "width",
        "height",
        "fps",
        "audio",
        "alpha"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "description",
    "inputs",
    "command",
    "output"
  ],
  "additionalProperties": false
}
