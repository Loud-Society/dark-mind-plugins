{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://darkmind.cloud/schemas/editing-pipeline/v1/timeline.schema.json",
  "title": "Dark Mind editing pipeline: timeline.json",
  "description": "Format contract v1 of the Dark Mind editing pipeline (doc/AI_EDITING_PIPELINE.md). Structure only; run \"darkmind-agent validate\" for references, frame arithmetic, overlaps, gaps and path rules.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 500,
      "description": "Optional JSON Schema reference for editors; ignored by the validator."
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "video": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "main",
              "b-roll",
              "graphics",
              "overlay"
            ]
          },
          "clips": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                },
                "sourceId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                },
                "extensionId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                },
                "statementId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                },
                "brollId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                },
                "sceneId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                },
                "in": {
                  "type": "string",
                  "pattern": "^(?:(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,12})?|(?:0|[1-9][0-9]{0,17})\\/[1-9][0-9]{0,17})$",
                  "description": "Source in-point (seconds); for extension clips seconds from the start of the rendered output"
                },
                "out": {
                  "type": "string",
                  "pattern": "^(?:(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,12})?|(?:0|[1-9][0-9]{0,17})\\/[1-9][0-9]{0,17})$"
                },
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Timeline start in whole frames"
                },
                "crop": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "string",
                      "pattern": "^(?:(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,12})?|(?:0|[1-9][0-9]{0,17})\\/[1-9][0-9]{0,17})$"
                    },
                    "y": {
                      "type": "string",
                      "pattern": "^(?:(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,12})?|(?:0|[1-9][0-9]{0,17})\\/[1-9][0-9]{0,17})$"
                    },
                    "w": {
                      "type": "string",
                      "pattern": "^(?:(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,12})?|(?:0|[1-9][0-9]{0,17})\\/[1-9][0-9]{0,17})$"
                    },
                    "h": {
                      "type": "string",
                      "pattern": "^(?:(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,12})?|(?:0|[1-9][0-9]{0,17})\\/[1-9][0-9]{0,17})$"
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "w",
                    "h"
                  ],
                  "additionalProperties": false,
                  "description": "Normalised rectangle (0..1) in the correctly oriented source image with the output aspect ratio (rule G1)"
                }
              },
              "required": [
                "id",
                "in",
                "out",
                "start"
              ],
              "additionalProperties": false
            },
            "maxItems": 5000
          }
        },
        "required": [
          "id",
          "role",
          "clips"
        ],
        "additionalProperties": false
      },
      "maxItems": 32,
      "description": "Video tracks, bottom to top (array order is the stacking order)"
    },
    "audio": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "dialog",
              "b-roll",
              "music",
              "effects"
            ]
          },
          "clips": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                },
                "sourceId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                },
                "extensionId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                },
                "statementId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                },
                "brollId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                },
                "sceneId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                },
                "in": {
                  "type": "string",
                  "pattern": "^(?:(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,12})?|(?:0|[1-9][0-9]{0,17})\\/[1-9][0-9]{0,17})$",
                  "description": "Source in-point (seconds); for extension clips seconds from the start of the rendered output"
                },
                "out": {
                  "type": "string",
                  "pattern": "^(?:(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,12})?|(?:0|[1-9][0-9]{0,17})\\/[1-9][0-9]{0,17})$"
                },
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Timeline start in whole frames"
                },
                "gainDb": {
                  "type": "number",
                  "minimum": -96,
                  "maximum": 36
                },
                "linkedTo": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
                  "description": "Video clip with the same source range and position (linked in Premiere)"
                }
              },
              "required": [
                "id",
                "in",
                "out",
                "start",
                "gainDb"
              ],
              "additionalProperties": false
            },
            "maxItems": 5000
          }
        },
        "required": [
          "id",
          "role",
          "clips"
        ],
        "additionalProperties": false
      },
      "maxItems": 32
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "fill": {
            "type": "string",
            "enum": [
              "black",
              "silence",
              "black-and-silence"
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "start",
          "end",
          "fill"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000,
      "default": [],
      "description": "Intended black/silent ranges; every other uncovered frame is an error"
    }
  },
  "required": [
    "schemaVersion",
    "video",
    "audio"
  ],
  "additionalProperties": false
}
