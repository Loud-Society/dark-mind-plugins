{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://darkmind.cloud/schemas/editing-pipeline/v1/toolchain.schema.json",
  "title": "Dark Mind editing pipeline: toolchain.json",
  "description": "Format contract v1 of the Dark Mind editing pipeline (doc/AI_EDITING_PIPELINE.md). Structure only; run \"darkmind-agent validate\" for references, frame arithmetic, overlaps, gaps and path rules.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 500,
      "description": "Optional JSON Schema reference for editors; ignored by the validator."
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "pipeline": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "skill": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "required": [
            "version"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "brandPack": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100
            },
            "maxItems": 200
          }
        },
        "required": [
          "name",
          "version"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    }
  },
  "required": [
    "schemaVersion",
    "pipeline",
    "tools"
  ],
  "additionalProperties": false
}
