    "imageManifest": "images/assets.json",
    "defaults": {
      "voiceShout": "voice-shout-guy",
      "voiceSpoken": "voice-spoken-guy",
      "noiseHit": "noise-hit-c",
      "animal": { "peacock": "animal-peacock-1", "rooster": "animal-rooster-1", "stag": "animal-stag-1" },
      "loudSounds": ["loud-jackhammer-1", "loud-helicopter-1", "animal-peacock-1"],
      "endcard": "endcard-angled-gpt-image-2-1"
    }
  },
