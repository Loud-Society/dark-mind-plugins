    "suffixes": {
      "description": "Localised wordmarks loud>society>suffix (brand-assets/logo/wordmark-<suffix>.svg inline for 16:9, -stacked.svg for 9:16; further suffixes with brand-assets/tools/build-logo.mjs --suffix <name>)",
      "available": ["brazil", "indonesia", "colombia"],
      "inlineSuffixLeft": 446.81,
      "stackedSplitY": 77.4
    }
  },
  "assets": {
    "description": "AI/library assets of brand-assets/ (manifests audio/assets.json and images/assets.json, T13). Blocks pick them by id; the defaults are the documented candidates until Loud Society selects (status \"selected\"). add-block vendors the chosen files to extensions/brand-pack/assets/audio/<id>.wav and assets/images/<id>.jpg.",
