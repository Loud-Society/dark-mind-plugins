      "medium": { "weight": 500, "file": "Neuborn-Medium.ttf", "source": "fonts/neuborn/ttf/Neuborn Medium.ttf" },
      "bold": { "weight": 700, "file": "Neuborn-Bold.ttf", "source": "fonts/neuborn/ttf/Neuborn Bold.ttf" }
    },
    "requiredGlyphs": "ÄÖÜäöüß"
