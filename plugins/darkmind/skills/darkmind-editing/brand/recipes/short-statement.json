{
  "schemaVersion": 1,
  "kind": "darkmind-brand-recipe",
  "id": "short-statement",
  "title": "Short \"Statement with cold open\" (9:16)",
  "document": "short-statement.md",
  "profile": "vertical",
  "duration": {
    "minSeconds": 30,
    "maxSeconds": 65
  },
  "captions": {
    "styles": [
      "brand-word",
      "brand-phrase"
    ],
    "required": true,
    "default": "brand-word"
  },
  "audioMaster": "required",
  "music": {
    "slot": "optional",
    "track": "audio track with role \"music\"",
    "note": "MVP without music bed (T14, decided 2026-11-08): the template ships no music; a music bed needs its source and rights documented in sources.json (asset provenance) and is ducked by audio_master"
  },
  "blocks": {
    "logo_sting": {
      "use": "required",
      "min": 1,
      "max": 1,
      "role": "full screen after the statement sentence; suffix optional"
    },
    "lower_third": {
      "use": "required",
      "min": 1,
      "max": 1
    },
    "caption_word": {
      "use": "optional",
      "max": 1
    },
    "caption_phrase": {
      "use": "optional",
      "max": 1
    },
    "animal_scream": {
      "use": "required",
      "min": 1,
      "max": 1
    },
    "logo_end": {
      "use": "required",
      "min": 1,
      "max": 1
    },
    "wordmark_flash": {
      "use": "optional"
    },
    "chevron_wipe": {
      "use": "optional"
    },
    "glitch_flash": {
      "use": "optional"
    }
  },
  "groups": [
    {
      "id": "captions",
      "oneOf": [
        "caption_word",
        "caption_phrase"
      ],
      "note": "one caption overlay matching captions.json style"
    }
  ],
  "order": [
    "logo_sting",
    "lower_third",
    "animal_scream",
    "logo_end"
  ],
  "endsWith": "logo_end",
  "hook": {
    "until": "logo_sting",
    "forbidden": [
      "lower_third"
    ],
    "note": "statement sentence 2–4 s before the sting"
  },
  "chapters": {
    "required": false
  },
  "done": {
    "reviews": [
      "editorial",
      "captions-text",
      "preview",
      "final"
    ],
    "note": "outside the duration frame the duration-exception review is needed as well"
  },
  "rules": [
    "Statement sentence 2–4 s → logo sting (full screen) → lower third → argument/story with B-roll and captions → animal scream → logo end.",
    "No lower third in the cold open."
  ]
}
